# =========================================
# AI MARKETING AGENT - Backend Environment
# Copy this file to .env and fill in values.
# NEVER commit the real .env file.
# =========================================

# --- App ---
APP_NAME="AI Marketing Agent"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Security / Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_marketing_agent
# Full URL is assembled by config.py, but can be overridden:
DATABASE_URL=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI Providers ---
# Never expose these to the frontend. Backend-only.
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
DEFAULT_AI_PROVIDER=anthropic   # anthropic | openai

# --- S3-Compatible Storage ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=ai-marketing-agent-assets
S3_REGION=us-east-1

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute

# --- Field-level Encryption (for ConnectedAccounts credentials) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# --- Outbound Email (password reset, email verification) — Week 2 ---
# Leave SMTP_HOST empty for local dev: emails are logged instead of sent,
# so registration/password-reset/verification all still work end-to-end —
# just check the backend log for the link instead of an inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@ai-marketing-agent.local
SMTP_FROM_NAME="AI Marketing Agent"

# --- Frontend URL (used to build links inside emails) ---
FRONTEND_BASE_URL=http://localhost:3000

# --- Token expiry (Week 2) ---
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
